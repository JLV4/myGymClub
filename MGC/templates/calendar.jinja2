<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Workout Calendar — myGymClub</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/css/bootstrap.min.css" integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>

    <style>
        :root {
            --teal: #1abc9c;
            --teal-d: #16a085;
            --navy: #2c3e50;
            --navy-m: #34495e;
            --slate: #ecf0f1;
            --card-bg: #ffffff;
            --muted: #7b8d9d;
            --border: #dce3ea;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            display: flex;
            height: 100vh;
            background-color: var(--slate);
        }

        .sidebar {
            width: 210px;
            background: linear-gradient(180deg, #1e2e3d 0%, var(--navy) 100%);
            padding: 24px 16px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            flex-shrink: 0;
            border-right: 3px solid var(--teal);
            position: sticky;
            top: 0;
            height: 100vh;
        }

        .sidebar-brand {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 28px;
            color: var(--teal);
            letter-spacing: 2px;
            padding: 0 8px 16px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            margin-bottom: 8px;
        }

        .sidebar a {
            text-decoration: none;
        }

        .sidebar .nav-btn {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 11px 14px;
            background: transparent;
            color: rgba(255,255,255,0.7);
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
            width: 100%;
            text-align: left;
            font-family: 'DM Sans', sans-serif;
        }

        .sidebar .nav-btn i {
            font-size: 16px;
            width: 20px;
            text-align: center;
        }

        .sidebar .nav-btn:hover,
        .sidebar .nav-btn.active {
            background: rgba(26, 188, 156, 0.15);
            color: var(--teal);
        }

        .sidebar .nav-btn.active {
            border-left: 3px solid var(--teal);
            padding-left: 11px;
        }

        .main-content {
            flex: 1;
            padding: 24px 28px;
            background-color: var(--slate);
            display: flex;
            flex-direction: column;
            min-width: 0;
            overflow-y: auto;
        }

        .topbar {
            background: linear-gradient(90deg, var(--navy) 0%, #3d5a73 100%);
            padding: 12px 24px;
            border-radius: 12px;
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-shrink: 0;
            box-shadow: 0 4px 20px rgba(44,62,80,0.25);
        }

        .topbar-welcome {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 22px;
            color: white;
            letter-spacing: 1.5px;
        }

        .xp-block {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
        }

        .xp-label {
            font-size: 11px;
            color: rgba(255,255,255,0.6);
            font-weight: 500;
        }

        .xp-bar-wrap {
            background: rgba(255,255,255,0.2);
            border-radius: 20px;
            width: 220px;
            height: 10px;
            overflow: hidden;
        }

        .xp-bar-fill {
            background: linear-gradient(90deg, var(--teal), #2ecc71);
            height: 100%;
            border-radius: 20px;
            transition: width 0.4s ease;
        }

        .topbar-icons {
            display: flex;
            gap: 20px;
            align-items: center;
        }

        .topbar-icon {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: white;
            text-decoration: none;
            font-size: 11px;
            transition: opacity 0.2s, transform 0.2s;
            cursor: pointer;
        }

        .topbar-icon i {
            font-size: 20px;
            margin-bottom: 2px;
        }

        .topbar-icon:hover {
            opacity: 0.75;
            transform: translateY(-2px);
            color: var(--teal);
            text-decoration: none;
        }

        .page-header {
            display: flex;
            align-items: baseline;
            gap: 12px;
            margin-bottom: 16px;
        }

        .page-title {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 36px;
            color: var(--navy);
            letter-spacing: 2px;
        }

        .page-sub {
            font-size: 13px;
            color: var(--muted);
            font-weight: 500;
        }

        .calendar-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 20px;
            box-shadow: 0 6px 18px rgba(44,62,80,0.06);
        }

        #calendar {
            max-width: 1000px;
            margin: auto;
        }

        .fc .fc-toolbar-title {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 24px;
            color: var(--navy);
        }

        .fc button {
            background-color: var(--teal) !important;
            border: none !important;
            color: white !important;
            border-radius: 6px !important;
            padding: 6px 12px !important;
            font-weight: 600 !important;
            transition: 0.2s;
        }

        .fc button:hover {
            background-color: var(--teal-d) !important;
        }

        .fc .fc-daygrid-event,
        .fc .fc-timegrid-event {
            border-radius: 6px;
            padding: 2px 4px;
            cursor: pointer;
        }

        .modal-title {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 24px;
            letter-spacing: 1px;
        }

        .modal-body p {
            margin-bottom: 10px;
            color: var(--navy);
        }
    </style>
</head>
<body>

    <div class="sidebar">
        <div class="sidebar-brand">myGymClub</div>
        <a href="/home"><button class="nav-btn"><i class="bi bi-house-door"></i> My Goals</button></a>
        <a href="/add-goals"><button class="nav-btn"><i class="bi bi-plus-circle"></i> Add Goal</button></a>
        <a href="/schedule-workout"><button class="nav-btn"><i class="bi bi-calendar-check"></i> Schedule</button></a>
        <a href="/friends"><button class="nav-btn"><i class="bi bi-people"></i> Friends</button></a>
        <a href="/events"><button class="nav-btn"><i class="bi bi-lightning-charge"></i> Events</button></a>
        <a href="/calendar"><button class="nav-btn active"><i class="bi bi-calendar3"></i> Calendar</button></a>
        <img src="/static/uicflameslogo.png" alt="UIC Flames Logo" style="width: 150px; height: auto; margin-top: auto; align-self: flex-start;">
    </div>

    <div class="main-content">

        <div class="topbar">
            <span class="topbar-welcome">Welcome, {{user}}!</span>
            <div class="xp-block">
                <div class="xp-label">Level {{level}}</div>
                <div class="xp-bar-wrap">
                    <div class="xp-bar-fill" style="width: {{xp_percentage}}%;"></div>
                </div>
            </div>
            <div class="topbar-icons">
                <div class="topbar-icon">
                    <i class="bi bi-fire" style="color:#e67e22;"></i>Streak: {{streak}}
                </div>
                <a class="topbar-icon" href="/home"><i class="bi bi-house-door"></i>Home</a>
                <a class="topbar-icon" href="/settings"><i class="bi bi-gear"></i>Settings</a>
                <a class="topbar-icon" href="/profile"><i class="bi bi-person-circle"></i>Profile</a>
                <a class="topbar-icon" href="{{login_link}}"><i class="bi bi-box-arrow-right"></i>Logout</a>
            </div>
        </div>

        <div class="page-header">
            <div class="page-title">Workout Calendar</div>
            <span class="page-sub">View your scheduled sessions and REC events</span>
        </div>

        <div class="calendar-card">
            <div id="calendar"></div>
        </div>
    </div>

    <!-- Event Modal -->
    <div class="modal fade" id="eventModal" tabindex="-1" role="dialog" aria-labelledby="eventModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content" style="border-radius: 12px;">
                <div class="modal-header">
                    <h5 class="modal-title" id="eventModalLabel">Event</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p id="modalDescription"></p>
                    <p><strong>Type:</strong> <span id="modalGoal"></span></p>
                    <p><strong>Start:</strong> <span id="modalStart"></span></p>
                    <p><strong>End:</strong> <span id="modalEnd"></span></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-success" id="logEventBtn">Log Event</button>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    

    <script>
        const workoutData = {{ workouts | tojson | safe }};
        const recEventsData = {{ events | tojson | safe }};

        console.log("RAW workouts:", workoutData);
        console.log("RAW events:", recEventsData);

        document.addEventListener('DOMContentLoaded', function() {
            const calendarEl = document.getElementById('calendar');

            // 🔹 Workouts already mostly valid → just normalize
            const workoutEvents = workoutData.map(w => ({
                id: "workout-" + w.id,
                title: (w.extendedProps?.completed ? "✅ " : "") + w.title,
                start: w.start,
                end: w.end,
                backgroundColor: w.extendedProps?.completed ? 'green' : (w.backgroundColor || ''),
                borderColor: w.extendedProps?.completed ? 'green' : (w.borderColor || ''),
                display: 'block',
                extendedProps: {
                    type: 'workout',
                    description: w.extendedProps?.description,
                    goal_name: w.extendedProps?.goal_name,
                    completed: Boolean(w.extendedProps?.completed)
                }
            }));

            // 🔹 Convert "6:00 PM" → "18:00:00"
            function convertTo24Hour(timeStr) {
                const [time, modifier] = timeStr.split(' ');
                let [hours, minutes] = time.split(':');

                if (modifier === 'PM' && hours !== '12') hours = parseInt(hours) + 12;
                if (modifier === 'AM' && hours === '12') hours = '00';

                return `${hours.toString().padStart(2, '0')}:${minutes}:00`;
            }

            // 🔹 Rec events (tuples → objects)
            const recEvents = recEventsData.map(e => ({
                id: "event-" + e[0],
                title: e[1],
                start: `${e[3]}T${convertTo24Hour(e[4])}`,
                end: `${e[3]}T${convertTo24Hour(e[5])}`,
                backgroundColor: '#3788d8',
                borderColor: '#3788d8',
                display: 'block',
                extendedProps: {
                    type: 'event',
                    description: e[6],
                    location: e[7],
                    organizer: e[2]
                }
            }));

            const allEvents = [...workoutEvents, ...recEvents];

            const calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                height: 'auto',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay'
                },
                events: allEvents,

                // 🔥 FORCE RENDER DEBUG
                eventDidMount: function(info) {
                    console.log("Rendered event:", info.event.title);
                },

                eventClick: function(info) {
                    const fcEvent = info.event;
                    const props = fcEvent.extendedProps;

                    document.getElementById('eventModalLabel').innerText = fcEvent.title;
                    document.getElementById('modalStart').innerText =
                        fcEvent.start ? fcEvent.start.toLocaleString() : '';
                    document.getElementById('modalEnd').innerText =
                        fcEvent.end ? fcEvent.end.toLocaleString() : '';

                    const logBtn = document.getElementById('logEventBtn');

                    if (props.type === 'workout') {
                        document.getElementById('modalDescription').innerText =
                            props.description || '';
                        document.getElementById('modalGoal').innerText =
                            props.goal_name || 'Workout';

                        logBtn.style.display = 'inline-block';

                        if (props.completed) {
                            logBtn.innerHTML = '✅ Logged';
                            logBtn.disabled = true;
                        } else {
                            logBtn.innerHTML = 'Log Workout';
                            logBtn.disabled = false;

                            logBtn.onclick = function() {
                                fetch(`/log-workout/${fcEvent.id.replace("workout-", "")}`, {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' }
                                })
                                .then(res => res.json())
                                .then(data => {
                                    if (data.success) {
                                        fcEvent.setExtendedProp('completed', true);
                                        logBtn.innerHTML = '✅ Logged';
                                        logBtn.disabled = true;

                                        if (!fcEvent.title.startsWith('✅ ')) {
                                            fcEvent.setProp('title', '✅ ' + fcEvent.title);
                                        }

                                        fcEvent.setProp('backgroundColor', 'green');
                                        fcEvent.setProp('borderColor', 'green');

                                        const xpBarFill = document.querySelector('.xp-bar-fill');
                                        const xpLabel = document.querySelector('.xp-label');
                                        xpLabel.innerText = `Level ${data.new_level}`;
                                        xpBarFill.style.width = data.xp_percentage + '%';
                                        if (data.old_level !== data.new_level){
                                            alert(`🎉 Congratulations, you've reached level ${data.new_level}! 🎉\nOnly ${data.xp_to_next_level} XP to reach the next level!`);
                                        }
                                        else {
                                            alert(`You just earned ${data.xp_gained} XP! ⭐️\nOnly ${data.xp_to_next_level} XP to reach the next level!`);
                                        }
                                    }
                                });
                            };
                        }
                    } else {
                        document.getElementById('modalDescription').innerText =
                            props.description || '';
                        document.getElementById('modalGoal').innerText =
                            `📍 ${props.location || 'No location'}`;

                        logBtn.style.display = 'none';
                    }

                    $('#eventModal').modal('show');
                }
            });

            console.log("Loaded events:", allEvents);
            calendar.render();
        });
    </script>

    <script src="https://code.jquery.com/jquery-3.4.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/js/bootstrap.min.js"></script>
</body>
</html>