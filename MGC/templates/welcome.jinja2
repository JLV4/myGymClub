{% block content %}
<style>
   /* Ensure layout consistency */
   *,
   *::before,
   *::after {
       box-sizing: border-box;
   }


   body {
       margin: 0;
       height: 100vh;
       font-family: 'Inter', sans-serif;
       display: flex;
       justify-content: center;
       align-items: center;
       background: radial-gradient(circle at top, #111, #050505);
       color: white;
       overflow: hidden;
   }


   /* Ambient on-screen glow effects */
   body::before {
       content: "";
       position: absolute;
       width: 500px;
       height: 500px;
       background: radial-gradient(circle, rgba(0,255,200,0.15), transparent 70%);
       top: -120px;
       left: -120px;
       filter: blur(120px);
   }


   body::after {
       content: "";
       position: absolute;
       width: 500px;
       height: 500px;
       background: radial-gradient(circle, rgba(0,150,255,0.15), transparent 70%);
       bottom: -120px;
       right: -120px;
       filter: blur(120px);
   }


   .card {
       position: relative;
       z-index: 2;
       width: 380px;
       padding: 50px 40px;
       border-radius: 20px;


       background: rgba(255, 255, 255, 0.05);
       backdrop-filter: blur(18px);


       border: 1px solid rgba(255,255,255,0.08);
       box-shadow: 0 20px 70px rgba(0,0,0,0.7);


       text-align: center;
       animation: fadeIn 0.8s ease;
   }


   @keyframes fadeIn
   {
       from {
           opacity: 0;
           transform: translateY(15px);
       }
       to {
           opacity: 1;
           transform: translateY(0);
       }
   }


   .logo {
       font-size: 12px;
       letter-spacing: 3px;
       color: #00ffc3;
       margin-bottom: 12px;
   }


   .card h1 {
       font-size: 30px;
       margin-bottom: 10px;
       font-weight: 700;
   }


   .card p {
       color: #aaa;
       margin-bottom: 30px;
       font-size: 14px;
   }


   /* Button group */
   .btn-group {
       display: flex;
       flex-direction: column;
       align-items: center;
       width: 100%;
   }


   .btn {
       display: block;
       width: 100%;
       padding: 14px;
       margin-bottom: 15px;
       border-radius: 12px;
       font-weight: 600;
       text-decoration: none;
       text-align: center;
       transition: all 0.25s ease;
   }


   .btn-login {
       background: linear-gradient(135deg, #00ffc3, #00aaff);
       color: black;
   }


   .btn-login:hover {
       transform: translateY(-2px);
       box-shadow: 0 10px 30px rgba(0,255,200,0.4);
   }


   .btn-register {
       background: transparent;
       border: 1px solid rgba(0,255,200,0.4);
       color: #00ffc3;
   }


   .btn-register:hover {
       background: rgba(0,255,200,0.08);
       box-shadow: 0 0 20px rgba(0,255,200,0.25);
       transform: translateY(-2px);
   }
</style>


<div class="card">
   <div class="logo">MYGYMCLUB</div>


   <h1>Own Your Workout</h1>
   <p>Track workouts. Find events. Achieve your goals.</p>


   <div class="btn-group">
       <a href="{{ url_for('login') }}" class="btn btn-login">Login</a>
       <a href="{{ url_for('register') }}" class="btn btn-register">Create Account</a>
   </div>
</div>


{% endblock %}
